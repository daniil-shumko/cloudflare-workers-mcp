# Cloudflare API Token
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Required permission: Workers Scripts -> Edit (or Read for read-only operations)
# The "Edit Cloudflare Workers" token template also works.
# Both user-owned and account-owned tokens are supported.
CLOUDFLARE_API_TOKEN=your_api_token_here

# Cloudflare Account ID
# Find at: https://dash.cloudflare.com (in the URL or sidebar)
CLOUDFLARE_ACCOUNT_ID=your_account_id_here
