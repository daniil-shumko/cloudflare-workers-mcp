{
  "name": "cloudflare-workers-mcp",
  "version": "1.2.0",
  "description": "MCP server for managing Cloudflare Workers: deploy static sites and Worker scripts, manage versions, deployments, custom domains, and cron triggers",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cloudflare-workers-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "dev": "tsup src/index.ts --format esm --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "npm run test:unit && npm run test:protocol",
    "test:unit": "node --import tsx --test \"test/unit/**/*.test.ts\"",
    "test:protocol": "npm run build && node --import tsx --test \"test/protocol/**/*.test.ts\"",
    "test:live": "CF_LIVE_TEST=1 node --import tsx --test \"test/integration/**/*.test.ts\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "static-assets",
    "mcp",
    "model-context-protocol",
    "claude",
    "deployments"
  ],
  "author": "Daniil Shumko",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniil-shumko/cloudflare-workers-mcp.git"
  },
  "homepage": "https://github.com/daniil-shumko/cloudflare-workers-mcp#readme",
  "bugs": {
    "url": "https://github.com/daniil-shumko/cloudflare-workers-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
